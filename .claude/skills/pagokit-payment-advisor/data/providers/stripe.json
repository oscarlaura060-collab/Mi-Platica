      "webhook",
      "events",
      "stripe-webhook"
    ],
    "ip_allowlist_available": true,
    "verification_family": "hmac_timestamp_body",
    "signature_location": "header",
    "hash_algo": "sha256",
    "secret_encoding": "raw",
    "digest_encoding": "hex",
    "signed_payload_template": "{timestamp}.{raw_body}",
    "signature_covers_body": true,
    "payload_authoritative": true,
    "timestamp_source": "signature_kv",
    "event_id_pointer": "/id",
    "event_type_pointer": "/type",
    "secret_env": "STRIPE_WEBHOOK_SECRET",
    "ack_deadline_seconds": 20,
    "evidence": {
      "confidence": "high",
      "verified_by": "human",
      "verified_at": "2026-05-20",
      "source_url": "https://stripe.com/docs",
      "note": "Migrated from the v1 catalog; scheme cross-checked against skills/webhook-verifier/signatures.md."
    },
    "header_format": {
      "kind": "kv",
      "signature_key": "v1",
      "timestamp_key": "t",
      "separator": ",",
      "assign": "="
    }
  },
