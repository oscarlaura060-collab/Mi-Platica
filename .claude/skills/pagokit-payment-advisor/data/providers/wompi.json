    "signature_pointer": "/signature/checksum",
    "hash_algo": "sha256",
    "secret_encoding": "raw",
    "digest_encoding": "hex",
    "signed_payload_template": "{body_props}{timestamp}{secret}",
    "signature_covers_body": false,
    "payload_authoritative": false,
    "timestamp_source": "body_field",
    "timestamp_pointer": "/timestamp",
    "event_id_pointer": "/data/transaction/id",
    "event_type_pointer": "/event",
    "secret_env": "WOMPI_EVENTS_SECRET",
    "evidence": {
      "confidence": "high",
      "verified_by": "human",
      "verified_at": "2026-05-20",
      "source_url": "https://docs.wompi.co",
      "note": "Scheme cross-checked against skills/webhook-verifier/signatures.md. Only the properties listed in signature.properties are covered by the checksum, so the handler must re-fetch the transaction before acting on any other field."
    },
    "refetch_endpoint": "GET https://production.wompi.co/v1/transactions/{data.transaction.id}"
  },
