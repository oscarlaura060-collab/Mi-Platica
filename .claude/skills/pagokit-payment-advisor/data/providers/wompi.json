  "webhook": {
    "signature_header": "Event-Signature",
    "algorithm": "SHA-256-checksum",
    "signature_includes_timestamp": true,
    "recommended_tolerance_seconds": 600,
    "replay_mitigation_strategy": "both",
    "required_events_minimum": [
